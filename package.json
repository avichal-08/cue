{
  "name": "cue",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test --concurrency=2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/compose.yml up -d --wait redis minio && docker compose -f infra/compose.yml run --rm minio-init",
    "infra:down": "docker compose -f infra/compose.yml down",
    "db:generate": "pnpm --filter @cue/db generate",
    "db:migrate": "pnpm --filter @cue/db migrate",
    "db:studio": "pnpm --filter @cue/db studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "turbo": "^2.11.8",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
